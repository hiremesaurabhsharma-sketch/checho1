---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-wrap">
      <div>
        <p class="eyebrow">Best coaching in Satna for class 6 to 12</p>
        <h1>Friendly teachers. Strong concepts. Better marks.</h1>
        <p>Udaan Classes helps students from class 6th to 12th build confidence in Maths, Science, English and board subjects with personal attention and regular progress updates.</p>
        <a class="btn" href="/admissions/">Start admission enquiry</a>
        <a class="btn secondary" href="/classes/">Explore classes</a>
      </div>
      <div class="hero-panel">
        <div class="float-card one"><h3>Daily doubt support</h3><p>Ask freely, learn calmly and revise until concepts feel easy.</p></div>
        <div class="stat-row"><div class="stat"><strong>6-12</strong>Classes</div><div class="stat"><strong>3x</strong>Tests</div><div class="stat"><strong>1:1</strong>Mentor</div></div>
        <div class="float-card two"><h3>Parent-friendly updates</h3><p>Regular feedback so parents always know the next step.</p></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Why families choose us</p>
      <h2>Aesthetic, disciplined and student-first coaching environment</h2>
      <div class="grid features">
        <div class="card"><h3>Foundation focus</h3><p>Class 6 to 10 students learn basics deeply before moving to advanced questions.</p></div>
        <div class="card"><h3>Board preparation</h3><p>Class 11 and 12 batches focus on NCERT clarity, writing practice and exam strategy.</p></div>
        <div class="card"><h3>Small batches</h3><p>Teachers know each student by name and give personal attention where it matters.</p></div>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
